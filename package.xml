<?xml version="1.0"?>
<package format="3">
  <name>steering_interface</name>
  <version>0.0.1</version>
  <description>ROS2 driver for the steering motor.</description>

  <maintainer email="johndoe@gmail.com">no_one</maintainer>
  <license>MIT</license>

  <!-- Build system -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependencies -->
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>

  <!-- Optional: for quaternion/euler conversions -->
  <exec_depend>python3-tf-transformations</exec_depend>

  <!-- Export -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

